# Copie para .env (ignorado pelo git). Defaults funcionam rodando no próprio Pi.
MQTT_HOST=localhost
MQTT_PORT=1883
INTERSECTION_ID=cruzamento1

# Visão computacional (semaphor-edge count). Ver docs/visao.md.
# Modelo: pasta NCNN exportada (recomendado) ou arquivo .pt.
VISION_MODEL=yolo26n_ncnn_model
# Classes COCO contadas como veículo (vazio = todas). Na maquete dá para simular com bottle,cup...
VISION_CLASSES=car,truck,bus
VISION_CONF=0.4
VISION_IMGSZ=640
ROIS_PATH=rois.json
