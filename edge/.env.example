# Copie para .env (ignorado pelo git). Defaults funcionam rodando no próprio Pi.
MQTT_HOST=localhost
MQTT_PORT=1883
INTERSECTION_ID=cruzamento1

# Controlador de fases (semaphor-edge run), em segundos. Padrão = ciclo local do ESP32.
GREEN_S=5
YELLOW_S=2
ALL_RED_S=1
# Reenvio do comando; deve ficar bem abaixo dos 10 s de timeout do ESP32.
HEARTBEAT_S=1

# Algoritmo de fila (semaphor-edge run --simulado e semaphor-edge simular).
MIN_GREEN_S=3
MAX_GREEN_S=15
# Tempo para um veículo cruzar com o verde (vazão de saturação).
SEC_PER_VEHICLE=1
# Chegadas simuladas por via, em veículos por segundo.
ARRIVALS=N=0.35,S=0.3,L=0.1,O=0.1
